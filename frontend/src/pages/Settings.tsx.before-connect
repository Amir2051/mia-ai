import { useState, useEffect } from 'react';
import api from '../services/api';

export default function Settings() {
  const [connected, setConnected] = useState(false);
  const [status, setStatus] = useState<any | null>(null);
  const [saved, setSaved] = useState(false);

  useEffect(() => {
    api.get('/auth/session')
      .then((res) => setConnected(!!res.data?.connected))
      .catch(() => setConnected(false));
    api.get('/shopify/status')
      .then((res) => setStatus(res.data))
      .catch(() => {});
  }, []);

  return (
    <div>
      <h1 style={{ fontSize: 24, marginBottom: 12 }}>Settings</h1>
      <div style={{ maxWidth: 480 }}>
        <div style={{ marginBottom: 16, padding: 16, border: '1px solid #e1e3e5', borderRadius: 8 }}>
          <h2 style={{ fontSize: 16, marginBottom: 8 }}>Shopify connection</h2>
          <p style={{ color: '#616161', marginBottom: 12 }}>{connected ? 'Connected' : 'Not connected'}</p>
          <button onClick={() => setSaved(true)} style={{ padding: '8px 12px' }}>Save configuration</button>
          {saved && <p style={{ color: '#008060' }}>Configuration updated. Restart the backend after setting real environment variables.</p>}
          {status && (
            <pre style={{ background: '#f6f6f7', padding: 12, marginTop: 12, fontSize: 12 }}>
              {JSON.stringify(status, null, 2)}
            </pre>
          )}
        </div>
        <div style={{ padding: 16, border: '1px solid #e1e3e5', borderRadius: 8 }}>
          <h2 style={{ fontSize: 16, marginBottom: 8 }}>Application settings</h2>
          <p style={{ color: '#616161' }}>Import settings, margin defaults, and webhook status will be added here.</p>
        </div>
      </div>
    </div>
  );
}
