# Mia AI environment configuration
# Copy to .env for local development. Never commit real secrets.

ENVIRONMENT=development

# Application
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///./dev.db
CORS_ORIGINS=http://localhost:5173

# Shopify Partner app (Mia AI client ID: 9c422dedf9e850a1f8fb3078ca747fa7)
SHOPIFY_API_KEY=9c422dedf9e850a1f8fb3078ca747fa7
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:8000
SHOPIFY_REDIRECT_URIS=http://localhost:8000/api/auth/callback
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,read_inventory
SHOPIFY_API_VERSION=2026-07

# Token encryption: use a cryptographically random Fernet key in real environments
TOKEN_ENCRYPTION_KEY=

# Meta / Facebook + Instagram
# Create these in Meta for Developers. Never commit real secrets.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_BASE_URL=https://graph.facebook.com
# Leave blank to use the provider's default/current Graph endpoint.
META_GRAPH_API_VERSION=
META_OAUTH_VERSION=v24.0
# Defaults to <SHOPIFY_APP_URL>/api/social/meta/callback when blank.
META_REDIRECT_URI=
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish

# Production example
# ENVIRONMENT=production
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/mia
# SHOPIFY_APP_URL=https://drivenest.info
# SHOPIFY_REDIRECT_URIS=https://drivenest.info/auth/callback
# CORS_ORIGINS=https://drivenest.info
# SESSION_COOKIE_SECURE=true
