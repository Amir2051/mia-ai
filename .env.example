# Mia AI environment configuration
# Copy to .env for local development. Never commit real secrets.

ENVIRONMENT=development

# Application
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///./dev.db
CORS_ORIGINS=http://localhost:5173

# Shopify Partner app (Mia AI client ID: 9c422dedf9e850a1f8fb3078ca747fa7)
SHOPIFY_API_KEY=9c422dedf9e850a1f8fb3078ca747fa7
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:8000
SHOPIFY_REDIRECT_URIS=http://localhost:8000/api/auth/callback
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,read_inventory,read_publications,write_publications
SHOPIFY_API_VERSION=2026-07

# Token encryption: use a cryptographically random Fernet key in real environments
TOKEN_ENCRYPTION_KEY=

# Optional MIA-RZ chat provider. Disabled by default; never put keys in frontend config.
# Enable only after the RZ service is deployed and its HTTPS endpoint is verified.
RZ_AGENT_ENABLED=false
RZ_AGENT_BASE_URL=
RZ_AGENT_API_KEY=
RZ_AGENT_TIMEOUT_SECONDS=45

# Meta / Facebook + Instagram
# Create these in Meta for Developers. Never commit real secrets.
META_APP_ID=
META_APP_SECRET=
META_TEST_ACCESS_TOKEN=
META_GRAPH_API_BASE_URL=https://graph.facebook.com
# Leave blank to use the provider's default/current Graph endpoint.
META_GRAPH_API_VERSION=
META_OAUTH_VERSION=v24.0
# Defaults to <SHOPIFY_APP_URL>/api/social/meta/callback when blank.
META_REDIRECT_URI=
META_OAUTH_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts,instagram_basic,instagram_content_publish
META_LOGIN_CONFIG_ID=

# Other social platforms. Register the matching callback URL in each developer
# console. Leave secrets out of source control; set real values only in backend/.env.
# TikTok: <SHOPIFY_APP_URL>/api/social/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Pinterest: <SHOPIFY_APP_URL>/api/social/pinterest/callback
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=
# YouTube / Google OAuth: <SHOPIFY_APP_URL>/api/social/youtube/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# LinkedIn: <SHOPIFY_APP_URL>/api/social/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_API_VERSION=202607

# Production example
# ENVIRONMENT=production
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/mia
# SHOPIFY_APP_URL=https://mia.drivenest.info
# SHOPIFY_REDIRECT_URIS=https://mia.drivenest.info/auth/callback
# CORS_ORIGINS=https://mia.drivenest.info
# SESSION_COOKIE_SECURE=true
