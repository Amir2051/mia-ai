# Mia AI environment configuration
# Copy to .env for local development. Never commit real secrets.

ENVIRONMENT=development

# Application
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///./dev.db
CORS_ORIGINS=http://localhost:5173

# Shopify Partner app (App ID: 418029862913)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=http://localhost:8000
SHOPIFY_REDIRECT_URIS=http://localhost:8000/api/auth/callback
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,read_inventory
SHOPIFY_API_VERSION=2026-07

# Token encryption: use a cryptographically random Fernet key in real environments
TOKEN_ENCRYPTION_KEY=

# Production example (use PostgreSQL, not SQLite)
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/mia
# ENVIRONMENT=production
# SHOPIFY_APP_URL=https://your-mia-domain.example
# CORS_ORIGINS=https://your-mia-domain.example
